# Copiar a .env.local. Solo valores públicos con NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor (cron de recordatorios). Nunca NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...        # omite la RLS: solo la usa /api/cron/recordatorios
# CRON_SECRET=                             # Vercel lo manda como "Authorization: Bearer ..." al cron
# RESEND_API_KEY=re_...
# RESEND_FROM="FlotaControl <recordatorios@tu-dominio.com>"   # para probar: onboarding@resend.dev
# ALERTAS_CORREO=correo-real-del-dueno@ejemplo.com
